<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#1E1E2E">

    <ImageView
        android:id="@+id/notif_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/app_icon"
        android:layout_gravity="center_vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CDD6F4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A6ADC8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/notif_btn_action"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Aktion"
                android:textSize="11sp"
                android:backgroundTint="#89B4FA" />

            <Button
                android:id="@+id/notif_btn_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Dismiss"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F38BA8" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>